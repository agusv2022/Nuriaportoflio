---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import WorkFull from "../components/WorkFull.astro";
import WorkTrio from "../components/WorkTrio.astro";
import WorkDuo from "../components/WorkDuo.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import site from "../content/site.json";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const bySlug = Object.fromEntries(projects.map((p) => [p.id, p.data]));

/* El CMS guarda la referencia como ruta completa del archivo.
   Aceptamos también un slug suelto, por si se escribe a mano. */
const slugOf = (ref) => String(ref ?? "").split("/").pop().replace(/\.md$/, "");

const ordered = [...projects].sort((a, b) => a.data.order - b.data.order);

/* Resolver tolerante: si una referencia del CMS queda vacía o apunta
   a un proyecto borrado, avisamos por consola y usamos el primero
   disponible. Editar contenido nunca debe tumbar el build. */
function resolve(ref, slot) {
  const slug = slugOf(ref);
  let entry = bySlug[slug];

  if (!entry) {
    if (!ordered.length) {
      throw new Error("No hay ningún proyecto en src/content/projects/");
    }
    const fallback = ordered[0];
    console.warn(
      `[portada] El hueco "${slot}" apunta a "${slug || "(vacío)"}", que no existe. ` +
        `Se usa "${fallback.id}" en su lugar. Revísalo en el CMS.`
    );
    entry = fallback.data;
    return { ...entry, href: `/work/${fallback.id}`, image: entry.cover, alt: entry.coverAlt };
  }

  return { ...entry, href: `/work/${slug}`, image: entry.cover, alt: entry.coverAlt };
}

const featured = resolve(site.featured?.project, "destacado");
const fullBleed = resolve(site.fullBleed?.project, "ancho completo");
const trioProject = resolve(site.trio?.project, "tres columnas");
const duo = { ...resolve(site.duo?.project, "dos columnas"), ...site.duo };

/* El bloque de tres columnas necesita tres imágenes. Si la galería
   trae menos, completamos con la portada para no romper la retícula. */
const gallery = trioProject.gallery ?? [];
const images = [0, 1, 2].map(
  (i) => gallery[i] ?? { src: trioProject.cover, alt: trioProject.coverAlt }
);
const trio = { ...trioProject, images };
---

<Base title={site.seoTitle} description={site.seoDescription}>
  <Header brand={site.brand} nav={site.nav} contactButton={site.contactButton} />

  <main>
    <Hero hero={site.hero} featured={featured} />
    <WorkFull workIntro={site.workIntro} fullBleed={fullBleed} />
    <WorkTrio trio={trio} />
    <WorkDuo duo={duo} />
    <Services services={site.services} />
    <About about={site.about} />
    <Contact contact={site.contact} />
  </main>

  <Footer footer={site.footer} />
</Base>
