---
const { contact } = Astro.props;
---
<section id="contact" class="contacto">
  <div class="wrap">
    <div class="head g">
      <p class="eyebrow" data-anim="fade">{contact.eyebrow}</p>
      <h2 class="collab" data-anim="title">
        {contact.titleStart}<em>{contact.titleItalic}</em>
      </h2>
      <p class="lede sub" data-anim="read">{contact.text}</p>
    </div>

    <div class="body g">
      <form class="form" action={contact.formAction} method="POST" data-anim="fade">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button class="btn" type="submit"><span>{contact.submitLabel}</span><i>&rarr;</i></button>
      </form>

      <div class="aside" data-anim="fade">
        <a class="mailto" href={`mailto:${contact.email}`}>{contact.email}</a>
        <div class="socials">
          {contact.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener">
              <span>{s.label}</span><i>&rarr;</i>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head{margin-bottom:var(--s6);text-align:center}
  .head .eyebrow{grid-column:1 / -1;margin-bottom:var(--s4)}
  .collab{
    grid-column:1 / -1;
    font-size:clamp(52px,9.5vw,148px);line-height:1;letter-spacing:-.03em;
  }
  .sub{grid-column:4 / span 6;margin-top:var(--s4)}

  .form{grid-column:1 / span 6}
  .aside{grid-column:8 / span 5;align-self:start}

  .field{margin-bottom:var(--s3)}
  .field label{
    display:block;font-size:10.5px;font-weight:500;letter-spacing:.22em;
    text-transform:uppercase;color:var(--gray);margin-bottom:10px;
  }
  .field input,.field textarea{
    width:100%;font-family:var(--sans);font-size:15px;color:var(--ink);
    background:var(--paper-2);border:1px solid transparent;border-radius:0;
    padding:16px 18px;transition:border-color .3s,background .3s;
  }
  .field textarea{min-height:150px;resize:vertical}
  .field input:hover,.field textarea:hover{border-color:var(--line)}
  .field input:focus,.field textarea:focus{
    outline:none;border-color:var(--blue-ink);background:var(--paper);
  }
  .form .btn{margin-top:var(--s2)}

  .mailto{
    font-family:var(--display);font-size:clamp(20px,2.2vw,32px);
    text-decoration:none;border-bottom:1px solid var(--line);padding-bottom:8px;
    transition:color .35s,border-color .35s;display:inline-block;
  }
  .mailto:hover,.mailto:focus-visible{color:var(--blue-ink);border-color:var(--blue-ink)}

  .socials{margin-top:var(--s5);display:flex;flex-direction:column;gap:1px}
  .socials a{
    background:var(--paper-2);padding:20px 26px;text-decoration:none;
    font-size:11px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;
    color:var(--gray);display:flex;justify-content:space-between;align-items:center;
    transition:background .35s var(--ease),color .35s var(--ease);
  }
  .socials a i{font-style:normal;transition:transform .4s var(--ease)}
  .socials a:hover{background:var(--blue-ink);color:var(--paper)}
  .socials a:hover i{transform:translateX(6px)}

  @media(max-width:1024px){
    .sub{grid-column:2 / span 6}
    .form{grid-column:1 / span 8}
    .aside{grid-column:1 / span 8;margin-top:var(--s5)}
  }
  @media(max-width:640px){
    .sub,.form,.aside{grid-column:1 / -1}
    .collab{font-size:clamp(46px,17vw,72px)}
    .form .btn{width:100%;justify-content:center}
  }
</style>
