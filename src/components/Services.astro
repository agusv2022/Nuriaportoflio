---
const { services } = Astro.props;
---
<section id="services" class="services">
  <div class="wrap">
    <div class="head g">
      <p class="eyebrow" data-anim="fade">{services.eyebrow}</p>
      <h2 data-anim="title">{services.heading}</h2>
    </div>

    <ul class="rows" data-rows>
      {services.items.map((item) => (
        <li>
          <span class="num">{item.number}</span>
          <h3 class="name">{item.name}</h3>
          <p class="small">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services{background:var(--paper-2)}
  .head{margin-bottom:var(--s6)}
  .head .eyebrow{grid-column:1 / span 3;align-self:center}
  .head h2{grid-column:4 / span 7}

  .rows{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  .rows li{
    display:grid;
    grid-template-columns:80px minmax(0,1fr) minmax(0,1.15fr);
    gap:var(--gut);align-items:baseline;
    padding-block:clamp(26px,2.6vw,40px);
    border-bottom:1px solid var(--line);
    transition:color .35s var(--ease);
  }
  .num{
    font-family:var(--display);font-size:14px;color:var(--blue);
    letter-spacing:.08em;font-variant-numeric:tabular-nums;
  }
  .name{transition:color .35s var(--ease),transform .5s var(--ease)}
  .rows li:hover .name{color:var(--blue-ink);transform:translateX(8px)}
  .rows li:hover .small{color:var(--ink)}

  @media(max-width:1024px){
    .head .eyebrow{grid-column:1 / -1;margin-bottom:var(--s2)}
    .head h2{grid-column:1 / span 7}
    .rows li{grid-template-columns:60px minmax(0,1fr);row-gap:10px}
    .rows li .small{grid-column:2}
  }
  @media(max-width:640px){
    .rows li{grid-template-columns:1fr;row-gap:8px}
    .rows li .small{grid-column:1}
    .rows li:hover .name{transform:none}
  }
</style>
